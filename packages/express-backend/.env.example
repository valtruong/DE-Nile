# Copy this file to .env (same folder) and fill it in.
# .env is git-ignored: NEVER commit it. Share the filled-in
# file with teammates in a private message instead.

# ---- Shared accounts (MongoDB Atlas) ----
# Atlas → your cluster → Connect → Drivers → copy the string,
# then replace <password> with the database user's password.
# Leave blank to keep accounts in data/users.json on this
# laptop only.
MONGODB_URI=
MONGODB_DB=denile

# ---- Email for verification / reset codes (Gmail) ----
# Needs a Gmail app password (not the normal password):
# myaccount.google.com/apppasswords
# Leave SMTP_HOST blank to print codes in the terminal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DE-Nile <your-team-gmail@gmail.com>

# ---- Sessions ----
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Who may create an account (comma-separated). Default:
# calpoly.edu. Set to an empty value to allow any email.
# ALLOWED_EMAIL_DOMAINS=calpoly.edu
